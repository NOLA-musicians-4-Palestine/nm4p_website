---
permalink: /charts.json
layout: null
---
{% assign files = site.static_files | where_exp: "f", "f.path contains '/assets/charts/'" | where: "extname", ".pdf" -%}
{"titles":{ {%- for s in site.songs -%}{%- assign slug = s.charts_folder | split: '/' | last -%}{{ slug | jsonify }}:{{ s.title | jsonify }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} },
"files":[{% for f in files %}{{ f.path | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}]}
